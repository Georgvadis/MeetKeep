{
  "manifest_version": 3,
  "name": "Vidloader",
  "version": "0.2.0",
  "description": "Скачать видео из текущей вкладки через локальный Vidloader",
  "permissions": ["activeTab", "cookies"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Скачать видео в Vidloader"}
}
